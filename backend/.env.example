# ==============================================================================
# CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# ==============================================================================
PROJECT_NAME="Sistema de Gestión de Cursos Preparatorios - Maestría"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Seguridad JWT
# En producción EC2, genere una clave segura: openssl rand -hex 32
SECRET_KEY="super-secret-key-change-this-in-production-use-strong-hash"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# BASE DE DATOS (AWS RDS o SQLite local)
# ==============================================================================
# Modo desarrollo local:
DATABASE_URL="sqlite:///./master_preparatory.db"

# Para conectar con AWS RDS PostgreSQL descomentar y configurar:
# DATABASE_URL="postgresql://db_user:db_password@rds-instance-endpoint.us-east-1.rds.amazonaws.com:5432/master_prep_db"

# ==============================================================================
# ALMACENAMIENTO DE ARCHIVOS (AWS S3 o Local)
# ==============================================================================
# Opciones para STORAGE_BACKEND: "local" o "s3"
STORAGE_BACKEND="local"
LOCAL_UPLOAD_DIR="./uploads"

# Credenciales AWS S3 (Obligatorio solo si STORAGE_BACKEND="s3")
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="master-preparatory-evidences-bucket"

# ==============================================================================
# NOTIFICACIONES Y ALERTAS (SMTP / Email)
# ==============================================================================
# Si no se configuran, las notificaciones se registran en logs y base de datos
SMTP_ENABLED=False
SMTP_HOST="email-smtp.us-east-1.amazonaws.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="notificaciones@universidad-maestrias.edu"
EMAILS_FROM_NAME="Coordinación de Maestrías"
